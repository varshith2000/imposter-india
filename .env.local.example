# Supabase — required for online multiplayer & saving progress to the cloud.
# Practice Mode (vs bots) and the local profile work fully offline without these.
#
# 1. Create a free project at https://supabase.com
# 2. Copy the Project URL and the (publishable) anon key from
#    Project Settings → API
# 3. Run supabase/schema.sql, then supabase/seed.sql, then supabase/seed-unlockables.sql
#    in the Supabase SQL editor
# 4. Enable Anonymous sign-ins: Authentication → Sign In Providers → Anonymous → Enable
#    (Google/email providers can be enabled the same way)
# 5. Copy this file to ".env.local" and fill in the values below.

# The full Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable (anon) key — a long JWT (~200+ chars), NOT the project name.
# It usually starts with "eyJ..." (legacy anon key) or "sb_publishable_..." (new key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# (Optional) The legacy name still works as a fallback:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
